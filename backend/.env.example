# 多模态分析系统 - 后端环境变量配置
# 复制此文件为 .env.local 并填入你的 API 密钥
# 各键默认值与 app/config.py 的 Settings 保持一致；留空或缺省即用默认值。

# ============ 服务 ============
# 后端监听端口
BACKEND_PORT=8010

# ============ 供应商 API Key（文字与视觉统一走 VLM 端点，无独立 LLM provider）============
MODELSCOPE_API_KEY=
MODELSCOPE_VLM_MODEL=Qwen/Qwen3.8-27B

# 阿里云百炼 DashScope（STT/TTS 也复用此 Key）
DASHSCOPE_API_KEY=
DASHSCOPE_VLM_MODEL=qwen3.8-27b
# 是否开启深度思考模式（qwen3.6-plus 默认支持）
DASHSCOPE_ENABLE_THINKING=true

DEEPSEEK_API_KEY=
DEEPSEEK_VLM_MODEL=deepseek-v4-flash

SENSENOVA_API_KEY=
SENSENOVA_VLM_MODEL=sensenova-6.8-flash-lite

ZHIPU_API_KEY=
ZHIPU_VLM_MODEL=glm-4.6v-flash

SILICONFLOW_API_KEY=

# ============ 默认供应商与生成参数 ============
# 默认 VLM 供应商：modelscope / dashscope / deepseek / sensenova / zhipu / siliconflow / custom:xxx
VLM_PROVIDER=modelscope
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TOP_P=0.95
LLM_SAMPLE_COUNT=1
LLM_FREQUENCY_PENALTY=0
# 输出格式：md / text
LLM_RESPONSE_FORMAT=md
LLM_ENABLE_THINKING=true

# ============ 语音识别 STT ============
# browser=浏览器 Web Speech；dashscope=阿里云百炼实时 ASR（Fun-ASR / Qwen3-ASR）；
# siliconflow / xinference / local_sensevoice（LOCAL_SENSEVOICE_URL 本地服务）
# 前端选「端侧语音（香橙派）」时后端不做云端转写，以下 STT 配置不参与
STT_PROVIDER=browser
# 由前端设置面板经 /config 同步持久化，一般无需手填
STT_MODEL=
QWEN3_ASR_MODEL=qwen3-asr-flash-realtime-2026-02-10
FUN_ASR_MODEL=fun-asr-realtime-2026-02-28
SILICONFLOW_STT_MODEL=FunAudioLLM/SenseVoiceSmall
LOCAL_SENSEVOICE_URL=http://localhost:8090
XINFERENCE_API_URL=http://localhost:9999
XINFERENCE_STT_MODEL=SenseVoiceSmall

# ============ 语音合成 TTS ============
# browser / xiaomi（小米 TTS，9 个官方音色）/ dashscope / siliconflow / local_cosyvoice
TTS_PROVIDER=xiaomi
TTS_ENABLED=true
XIAOMI_TTS_API_KEY=
XIAOMI_TTS_MODEL=mimo-v2.5-tts
XIAOMI_TTS_VOICE=mimo_default
DASHSCOPE_TTS_MODEL=qwen3-tts-instruct-flash-realtime
DASHSCOPE_TTS_VOICE=female-qn-tingting
SILICONFLOW_TTS_MODEL=fnlp/MOSS-TTSD-v0.5
SILICONFLOW_TTS_VOICE=fnlp/MOSS-TTSD-v0.5:claire
LOCAL_COSYVOICE_URL=http://localhost:5004
LOCAL_COSYVOICE_MODEL=CosyVoice-300M-SFT
LOCAL_COSYVOICE_VOICE=中文女

# ============ 对话/做饭链路功能开关 ============
# 做饭模式 AI 意图分类兜底：关键词全部未命中时用轻量 LLM 分类意图（确认/跳过/退出等），
# 超时/误判自动回退原问答行为，可一键关闭
AI_INTENT_FALLBACK_ENABLED=true
# 主对话大模型只读工具（function calling）：温度/重量/去皮/菜谱/风扇/语音模式等，
# 让模型拿实测数据回答；写操作仍由确定性拦截链路执行（详见 app/llm_tools.py）
LLM_TOOLS_ENABLED=true
# 油温问句旧版确定性快答（oil_watch.py 固定模板）。默认关闭，油温问句走 LLM 工具链路；
# 演示环境对工具链路不满意时置 true 切回旧快答
OIL_TEMP_FAST_ANSWER_ENABLED=false
# 秤零点自动跟踪：空秤读数小而稳持续一段时间后自动 Trim 基准，零点漂移免手动去皮
WEIGHT_AUTO_ZERO_ENABLED=true

# ============ 视觉与危险检测 ============
VISION_ENABLED=true
VISION_FPS=0.2
# 多帧时序聚合：滑动窗口帧数 / 触发阈值帧数（窗口内命中 >= 阈值才告警）
TEMPORAL_WINDOW=5
TEMPORAL_THRESHOLD=3
# 危险检测到设备控制闭环（缺真实设备自动降级 simulated）
SAFETY_DEVICE_CONTROL_ENABLED=true

# ============ 摄像头数据源 ============
# network = 网络摄像头（香橙派推流，断流自动回退本机）；local = 本机 USB 摄像头（忽略远程帧）
# 注意：每条配置必须独占一行——行末缺换行会把下一条配置拼进本条值里
CAMERA_SOURCE_MODE=network
# 远程流断流判定秒数（超过该时长没有新帧判定断流并回退本机）
REMOTE_CAMERA_FRESH_SECS=6

# 画面旋转角度（0/90/180/270，顺时针）：摄像头物理倒装时把画面转正，
# 仅作用于本机（/usb-camera/latest 出帧、VLM 收帧、前端 CSS 显示）；推流永远是原始帧。
# 前端"旋转画面"按钮会经 /env/update 自动持久化本键
CAMERA_ROTATION=180

# 本机 USB 摄像头采集分辨率覆盖（0 = 用摄像头默认）
# CAM_PROXY_WIDTH=0
# CAM_PROXY_HEIGHT=0

# ============ 唤醒词配置 ============
# 唤醒词统一由香橙派端侧 KWS（前端直连 ws://<边缘机>:8767/kws）承担，
# 后端本地方案（funasr / sherpa-onnx）已下线，后端不再加载任何唤醒词模型，
# 此项配置已废弃、保留仅为兼容旧 .env 中的残留键（读取后忽略）。

# ============ 下料机执行器配置（新版独立串口电磁阀控制器） ============
# 电磁阀串口设备名（空 = 自动探测，指定如 COM5 则直连该口不搜索）
VALVE_PORT=
# 电磁阀串口波特率（固定 9600 8N1）
VALVE_BAUDRATE=9600
# 下料执行器通道：valve = 新版电磁阀（默认），legacy_relay = 旧板卡继电器（回退）
DISPENSE_EXECUTOR=valve

# ============ 温度假数据源（演示用，默认关闭） ============
# 开启后 /temperature 接口、油温监测、温度语音快答全部改读模拟值：
# 围绕基准环境温度平滑随机游走（每秒更新一次，带缓慢正弦漂移），
# 不再读串口 / 温重板卡 Tmx / 香橙派远程红外。适合无传感器的演示环境。
TEMPERATURE_MOCK_ENABLED=false
# 基准环境温度（°C）
TEMPERATURE_MOCK_BASE=26.0
# 浮动幅度（°C，目标温度在基准 ± 此值内缓慢游走）
TEMPERATURE_MOCK_AMPLITUDE=1.2

# ============ 上下文向量记忆（超窗历史语义召回） ============
# 会话历史超出压缩窗口时，用向量检索召回语义相关的早期轮次，
# 替代启发式摘要；embedding 失败自动回落启发式压缩（原行为）。
# embedding 走 SiliconFlow BAAI/bge-m3（复用 SILICONFLOW_API_KEY）。
CONTEXT_VECTOR_ENABLED=true
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1/embeddings

# ============ 自定义 Provider（可选） ============
# JSON 格式，键必须以 custom: 开头；api_format 仅支持 openai / anthropic
# CUSTOM_PROVIDERS={"custom:my-openai":{"api_format":"openai","base_url":"https://example.com/v1","api_key":"sk-xxx","model":"my-model"}}
