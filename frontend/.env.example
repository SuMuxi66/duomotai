# 智能烹饪助手 - 主前端环境变量模板
# 复制此文件为 .env 后按需修改。
#
# 【重要】本文件不包含任何 API Key。
# 前端不保存、不持久化任何模型密钥：所有 provider 的 API Key 以【后端】backend/.env.local 为权威，
# 由后端 GET /config 的 api_keys 字段下发；本模板中的 VITE_DEFAULT_* 仅用于设置界面初值。
#
# 各键缺省值已与 src/lib/config.ts、vite.config.ts 中的默认值保持一致，留空即用默认值。

# ============ 服务地址 ============
# 后端 API 基址；留空则前端自动推断（默认 http://<当前主机>:8010）
VITE_API_BASE=http://127.0.0.1:8010
# 前端开发服务器端口（主前端 5179；副本 5180-5184）
VITE_FRONTEND_PORT=5179

# ============ 功能默认开关 ============
VITE_DEFAULT_VISION_ENABLED=true
# 视觉分析抽帧频率（帧/秒），0.2 表示每 5 秒一帧
VITE_DEFAULT_VISION_FPS=0.2
VITE_DEFAULT_TTS_ENABLED=true

# ============ 语音识别 STT 默认值 ============
# browser=浏览器 Web Speech；端侧语音请在前端设置页选择（不读本模板）
VITE_DEFAULT_STT_PROVIDER=browser
VITE_DEFAULT_STT_MODEL=Web Speech API

# ============ 语音合成 TTS 默认值 ============
# xiaomi / dashscope / siliconflow / browser
VITE_DEFAULT_TTS_PROVIDER=xiaomi
VITE_DEFAULT_TTS_MODEL=mimo-v2.5-tts
VITE_DEFAULT_TTS_VOICE=mimo_default

# ============ 视觉/文字大模型默认值（统一走 VLM 端点）============
# modelscope / dashscope / deepseek / sensenova / zhipu / custom:xxx
VITE_DEFAULT_VLM_PROVIDER=modelscope
VITE_DEFAULT_VLM_MODEL=Qwen/Qwen3.8-27B

# ============ 生成参数默认值 ============
VITE_DEFAULT_LLM_TEMPERATURE=0.7
VITE_DEFAULT_LLM_MAX_TOKENS=2048
VITE_DEFAULT_LLM_TOP_P=0.95
VITE_DEFAULT_LLM_SAMPLE_COUNT=1
VITE_DEFAULT_LLM_FREQUENCY_PENALTY=0
# 输出格式：md / json
VITE_DEFAULT_LLM_RESPONSE_FORMAT=md
VITE_DEFAULT_LLM_ENABLE_THINKING=false
