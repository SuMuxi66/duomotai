# 演示模块1 - 环境变量模板
# 复制此文件为 .env.local 后填入你自己的 API Key。
#
# 本文件只含占位符，请勿把真实密钥写进 .env.example（它会随仓库公开）。
# 模块1 的脚本也会自动尝试从 ../backend/.env.local 读取同名键。

# ============ 大模型 / 语料处理 ============
# 阿里云百炼
DASHSCOPE_API_KEY=sk-your-dashscope-key
# 魔搭社区 ModelScope
MODELSCOPE_API_KEY=sk-your-modelscope-key
# 硅基流动 SiliconFlow
SILICONFLOW_API_KEY=sk-your-siliconflow-key
# 深度求索 DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ============ 语音合成（小米 TTS）============
# 留空则自动关闭语音播报，不影响设备控制
XIAOMI_TTS_API_KEY=your-xiaomi-tts-key

# ============ 端侧语音服务地址（香橙派）============
EDGE_KWS_URL=ws://127.0.0.1:8767/kws
EDGE_ASR_URL=ws://127.0.0.1:8768/asr
